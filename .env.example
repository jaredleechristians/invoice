# OpenRouter (required)
OPENAI_API_KEY=
OPENAI_API_HOSTNAME=https://openrouter.ai/api
OPENAI_MODEL=openrouter/free

# PDF
GOTENBERG_HOSTNAME=https://gotenberg.robotweb.dev

# Firebase (optional — Google sign-in + multi-tenant API)
# 1. Firebase Console → Create project → Authentication → Sign-in method → enable Google
# 2. Project settings → Your apps → Web app → copy the config values below
# 3. Project settings → Service accounts → Generate new private key → minify JSON for FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/path/on/host.json

# Web client (from Firebase web app config; safe to expose in the browser)
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# Docker Compose:
#   docker compose up --build                              # dev (default, HMR)
#   docker compose -f docker-compose.prod.yml up --build   # production local build
#   docker compose -f docker-compose.ghcr.example.yml up   # GHCR images (example)

# Used by docker-compose.ghcr.example.yml
# IMAGE_TAG=latest
# API_PORT=8787
# WEB_PORT=3000
